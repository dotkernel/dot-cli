{
    "name": "dotkernel/dot-cli",
    "type": "library",
    "description": "Dotkernel component for creating console applications based on laminas-cli",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-cli",
    "keywords": [
        "cli",
        "console",
        "dotkernel",
        "laminas"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "laminas/laminas-cli": "^1.4.0",
        "laminas/laminas-servicemanager": "^3.11.1 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Cli\\": "src/"
        }
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "mikey179/vfsstream": "^1.6.7",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.2"
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Cli\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "static-analysis": "phpstan analyse --memory-limit 1G"
    }
}
